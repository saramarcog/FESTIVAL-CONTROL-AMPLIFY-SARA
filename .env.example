# Puerto del servidor backend
PORT=3001

# Configuración de AWS DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=FestivalEvents

# Si utilizas AWS Academy Learner Lab, copia y pega tus credenciales temporales
# desde el botón "AWS Details" -> "Show" de la consola del laboratorio:
# AWS_ACCESS_KEY_ID=ASIAR...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Si deseas conectar con DynamoDB Local (opcional, para desarrollo sin conexión):
# DYNAMODB_ENDPOINT=http://localhost:8000

